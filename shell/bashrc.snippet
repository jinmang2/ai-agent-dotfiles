# >>> ai-agent-dotfiles >>>
# claude-team / ccname / claude-accounts / tmux 창 이름 / alias
# 이 블록은 install.sh 가 통째로 갱신합니다. 직접 고치면 다음 설치에 덮어써집니다.
[ -f "$HOME/.config/agent-dotfiles/agents.sh" ]  && . "$HOME/.config/agent-dotfiles/agents.sh"
[ -f "$HOME/.config/agent-dotfiles/aliases.sh" ] && . "$HOME/.config/agent-dotfiles/aliases.sh"
# <<< ai-agent-dotfiles <<<
